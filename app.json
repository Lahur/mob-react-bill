{
  "expo": {
    "name": "Tehnomodus administracija",
    "slug": "tehnomodus-bill",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobreactbill",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tehnomodus.mobreactbill",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tehnomodus.mobreactbill",
      "adaptiveIcon": {
        "backgroundColor": "#12172B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12172B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-gradle-java-home.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28c9195e-04eb-421b-8dea-fb5c9575d69b"
      }
    },
    "owner": "tehnomodus-doo"
  }
}
